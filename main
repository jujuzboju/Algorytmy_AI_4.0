import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.model_selection import GroupShuffleSplit
from xgboost import XGBClassifier
from sklearn.metrics import classification_report

#Hej dziewczyny
df = pd.read_csv("dane/file.csv")

#Converting and spliting column with timestamp
df['timestamp'] = pd.to_datetime(df['timestamp']) 
df['hour'] = df['timestamp'].dt.hour
df['dayofweek'] = df['timestamp'].dt.day_of_week
df['month'] = df['timestamp'].dt.month

#Definding vectors y and group
y_bin = df['machine_failure']

le = LabelEncoder()
y_multi = le.fit_transform(df['failure_type'])
print("Category Mapping:", le.classes_)

y_reg = df['remaining_useful_life_hours']

group = df['machine_id']

#Creating matrix X
X = df.drop(columns=['machine_failure', 'failure_type', 'remaining_useful_life_hours', 'timestamp', 'last_maintenance_date', 'machine_id', 'monitoring_id', 'shift_hours'])
cols_in_str = X.select_dtypes(include=['object', 'string']).columns
for col in cols_in_str:
    X[col] = X[col].astype('category')

#Deleting sus column. It is possible to analyze it later
leakage_cols = [
    'bearing_health', 'motor_health', 'pump_health', 'hydraulic_health',
    'electrical_health', 'cooling_system_health',
    'temperature_anomaly_score', 'vibration_anomaly_score',
    'pressure_anomaly_score', 'electrical_anomaly_score', 'energy_anomaly_score',
    'machine_health_score', 'failure_probability', 'maintenance_priority'
]
X = X.drop(columns=leakage_cols)

#Spliting data
gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)
train_idx, test_idx = next(gss.split(X, y_bin, groups=group))

X_train = X.iloc[train_idx]
X_test = X.iloc[test_idx]
y_train = y_bin.iloc[train_idx]
y_test = y_bin.iloc[test_idx]

print("Rozmiar treningu:", X_train.shape, "Rozmiar testu:", X_test.shape)

#XGBmodel
xgbmodel = XGBClassifier(enable_categorical=True, scale_pos_weight=67, random_state=42)
xgbmodel.fit(X_train, y_train)

y_pred = xgbmodel.predict(X_test)
print("Metrics:", classification_report(y_test, y_pred))

# 2. Sprawdzamy, czy poszczególne typy awarii różnią się fizycznie na czujnikach!
sensors_check = [
    'temperature_c', 'vibration_mm_s', 'pressure_bar', 
    'bearing_temperature_c', 'motor_temperature_c', 'voltage_v', 'current_a'
]
print("\n--- Średnie odczyty czujników dla każdego typu awarii ---")
print(df.groupby('failure_type')[sensors_check].mean().round(2))

